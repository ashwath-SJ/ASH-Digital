# Optional. The site works without this file using the DEFAULT admin login:
#   username: admin
#   password: Ash@Admin#2026
# CHANGE IT before you put the website online:
#   cp .env.local.example .env.local   then fill in the values below and restart.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional: a long random text used to sign login cookies
AUTH_SECRET=
# Your real website address (used for SEO). When this is a public https address,
# the default login is switched off and your own ADMIN_USERNAME/ADMIN_PASSWORD are required.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact enquiry email delivery (SMTP). For Gmail, use smtp.gmail.com,
# port 465, and a newly generated Google App Password (not your regular
# Gmail password). Keep real credentials in .env.local; never commit them.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=ashdigital121@gmail.com
SMTP_PASS=
ENQUIRY_FROM_EMAIL=ashdigital121@gmail.com
